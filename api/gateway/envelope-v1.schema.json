{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/family-vpn/gateway-envelope-v1.schema.json",
  "title": "Gateway metadata envelope — DRAFT, NOT ACCEPTED AT RUNTIME",
  "description": "No command execution, firewall, routing or private keys. Transport parameter/secret schemas, signatures and validation are not implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "node_id",
    "recipient_node_id",
    "trust_epoch",
    "revision",
    "previous_revision",
    "created_at",
    "expires_at",
    "channels"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "recipient_node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "trust_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "previous_revision": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "protocol",
          "adapter_schema",
          "priority",
          "endpoint",
          "secret_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "protocol": {
            "enum": [
              "reality",
              "hysteria2"
            ]
          },
          "adapter_schema": {
            "type": "integer",
            "minimum": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "endpoint": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host",
              "port"
            ],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          },
          "secret_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Identifier scoped to this node/revision; never a URL or filesystem path. Secret delivery designed in GW-03."
          }
        }
      }
    }
  }
}
