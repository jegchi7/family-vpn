{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:family-vpn:local-stand:1",
  "title": "Synthetic local stand envelope (not production agent API)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "type",
    "target_id",
    "expected_revision",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "type": {
      "enum": [
        "ReadState",
        "EnsureDeviceProfiles",
        "RevokeDeviceProfiles"
      ]
    },
    "target_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4503599627370496
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        }
      }
    }
  }
}
