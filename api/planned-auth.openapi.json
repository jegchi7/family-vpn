{
  "openapi": "3.1.0",
  "info": {
    "title": "Family VPN planned authentication slice",
    "version": "0.5.0-draft",
    "description": "Remaining planned admin invitation operation. Local admin password/TOTP now implemented at /api/v1/auth/admin/password and /api/v1/auth/admin/totp in openapi.json. WebAuthn, recovery codes and fresh authentication remain planned."
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "request_id",
              "retryable"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "PasswordLogin": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "login",
          "password"
        ],
        "properties": {
          "login": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      },
      "InvitePassword": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token",
          "password"
        ],
        "properties": {
          "token": {
            "type": "string",
            "minLength": 43,
            "maxLength": 128
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 1024
          }
        }
      },
      "Challenge": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "challenge_id",
          "expires_at"
        ],
        "properties": {
          "challenge_id": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MFAProof": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "challenge_id",
          "code"
        ],
        "properties": {
          "challenge_id": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          }
        }
      },
      "SessionResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user_id",
          "role",
          "expires_at",
          "csrf_token"
        ],
        "properties": {
          "user_id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "csrf_token": {
            "type": "string"
          }
        }
      },
      "InviteRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user_id"
        ],
        "properties": {
          "user_id": {
            "type": "string"
          },
          "ttl_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 86400,
            "default": 86400
          }
        }
      },
      "InviteResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token",
          "expires_at"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "Show once; POST body on redemption, never access logs."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RecoveryProof": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token",
          "new_password"
        ],
        "properties": {
          "token": {
            "type": "string",
            "minLength": 43,
            "maxLength": 128
          },
          "new_password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 1024
          }
        }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-fvpn_session"
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }
    }
  },
  "paths": {
    "/api/v1/admin/invitations": {
      "post": {
        "operationId": "adminCreateInvite",
        "x-implementation-status": "planned",
        "x-listener": "admin",
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ],
        "description": "All browser calls require exact trusted Origin, including anonymous auth. No CORS. Planned, not implemented.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteResult"
                }
              }
            }
          },
          "400": {
            "description": "Standard error; no account enumeration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Standard error; no account enumeration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Standard error; no account enumeration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Standard error; no account enumeration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Standard error; no account enumeration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Standard error; no account enumeration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
