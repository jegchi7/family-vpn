{
  "name": "family-vpn-workspace",
  "version": "0.29.0",
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "setup": "npm --prefix web ci",
    "build": "node scripts/workspace.mjs build",
    "release:linux": "node scripts/release.mjs",
    "test:release": "node --test scripts/release.test.mjs",
    "demo": "node scripts/workspace.mjs demo",
    "check": "node scripts/workspace.mjs check",
    "test:e2e": "npm --prefix web run test:e2e",
    "test:persistence": "node scripts/persistence-smoke.mjs",
    "auth": "node scripts/workspace.mjs auth",
    "test:e2e:auth": "npm --prefix web run test:e2e:auth",
    "admin": "node scripts/workspace.mjs admin",
    "test:e2e:admin": "npm --prefix web run test:e2e:admin",
    "test:intents": "node scripts/intent-smoke.mjs"
  }
}
